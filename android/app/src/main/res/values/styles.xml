<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Fond crème pendant le chargement de l'interface (pas d'éclair blanc). -->
        <item name="android:windowBackground">@color/mc_background</item>
        <!-- Icônes de la barre d'état lisibles sur le fond crème (claires en mode sombre). -->
        <item name="android:windowLightStatusBar">@bool/mc_light_bars</item>
    </style>

    <!--
      Écran de lancement. L'image n'est posée QUE sur le fond de la fenêtre
      (windowBackground) : un « android:background » dans un thème s'applique à
      chaque vue, et étirait l'image dans une barre de titre native.
      Aucune barre de titre ni barre d'action dans aucun thème de l'app.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mc_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
